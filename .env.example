ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:3000

# Kafka / Redpanda
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_ACKS=1

# Redis
REDIS_URL=redis://redis:6379/0

# Timescale / Postgres
PG_DSN=postgresql://vigil:vigil@timescale:5432/vigil

# Neo4j (Local or Cloud Aura)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vigilneo4j

# Object store (MinIO / S3)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=vigil
S3_SECRET_KEY=vigilvigil123
S3_REGION=us-east-1

# Crypto & Security (DEV ONLY - Replace in production!)
SIGNER=file
SIGNING_KEY_PATH=/keys/dev_ed25519.pem
SIGNING_KEY_ID=dev-2026-01
PSEUDONYM_PEPPER=change-me-dev-pepper-32bytes-min
TSA_URL=

# AI & LLM (groq, anthropic, or none)
LLM_PROVIDER=none
# UNVERIFIED — list models via scripts/check_llm.py
LLM_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-3-haiku-20240307
GROQ_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=5.0
LLM_MAX_CONCURRENCY=8
LLM_TRACE_STORE_TEXT=false

# ==============================================================================
# DEFAULT PROFILE: Local Synthetic Demo (Simulator)
# ==============================================================================
MARKET_ADAPTER=websocket
MARKET_WS_URL=ws://simulator:8090/ws/market
INGEST_QUEUE_HIGH_WATERMARK=50000

SOCIAL_ADAPTER=synthetic_ws
SOCIAL_WS_URL=ws://simulator:8090/ws/social

# Simulator Epoch (ISO datetime or "now")
SIM_EPOCH=

# Agents & Clock
CLOCK_MODE=event
ALIGN_INTERVAL_S=5
ALIGN_LOOKBACK_S=3600
ORCH_MAX_CONCURRENT_CASES=8

# Auth & Security (DEV ONLY - Replace in production!)
ALLOW_DEV_TOKENS=true
JWT_HS256_SECRET=dev-secret-change-me-minimum-32-chars-long!
OIDC_ISSUER=
CORS_ALLOW_ORIGINS=http://localhost:3000

# Frontend URLs (host-accessible ports: API 8001 -> container 8000; sim 8090)
# NOTE: Next.js inlines NEXT_PUBLIC_* at build time. Rebuild container if changed!
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_SIM_URL=http://localhost:8090
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# Datasets
DATASET_REPO_URL=
DATASET_REPO_REF=main
DATASET_MODE=auto
GITHUB_TOKEN=

# ==============================================================================
# LIVE PROFILE: Real-World Ingestion (Activate with MARKET_ADAPTER=binance, SOCIAL_ADAPTER=live)
# ==============================================================================
# Binance Live Market Stream
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Discord OSINT Bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# Telegram OSINT Listener (Requires API_ID and API_HASH)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNELS=

# Reddit OSINT Stream (Requires Client ID & Secret)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=vigil:v1.0 (forensic surveillance platform)
REDDIT_SUBREDDITS=wallstreetbets,CryptoCurrency,pennystocks
