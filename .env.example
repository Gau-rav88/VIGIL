ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:3000

# Kafka / Redpanda
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_ACKS=1
# Redis
REDIS_URL=redis://redis:6379/0
# Timescale / Postgres
PG_DSN=postgresql://vigil:vigil@timescale:5432/vigil
# Neo4j (Local or Cloud Aura)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vigilneo4j
# Object store
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=vigil
S3_SECRET_KEY=vigilvigil123
S3_REGION=us-east-1
# Crypto
SIGNER=file
SIGNING_KEY_PATH=/keys/dev_ed25519.pem
SIGNING_KEY_ID=dev-2026-01
PSEUDONYM_PEPPER=change-me-dev-pepper-32bytes-min
TSA_URL=

# AI & LLM (Groq Free Inference or Anthropic)
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=5.0
LLM_MAX_CONCURRENCY=8
LLM_TRACE_STORE_TEXT=false

# Real-World Market Inputs (binance or websocket simulator)
MARKET_ADAPTER=binance
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKET_WS_URL=ws://simulator:8090/ws/market
INGEST_QUEUE_HIGH_WATERMARK=50000

# Real-World Social Inputs (live or synthetic_ws)
SOCIAL_ADAPTER=live
SOCIAL_WS_URL=ws://simulator:8090/ws/social

# Discord OSINT Bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# Telegram OSINT Listener
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_CHANNELS=binance_announcements,cryptopumpalerts,wallstreetbets

# Reddit OSINT Stream
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=vigil:v1.0 (forensic surveillance platform)
REDDIT_SUBREDDITS=wallstreetbets,CryptoCurrency,pennystocks

# Datasets
DATASET_REPO_URL=
DATASET_REPO_REF=main
DATASET_MODE=auto
GITHUB_TOKEN=
# Agents
ALIGN_INTERVAL_S=5
ALIGN_LOOKBACK_S=3600
ORCH_MAX_CONCURRENT_CASES=8
# Auth (dev)
JWT_HS256_SECRET=dev-secret-change-me
OIDC_ISSUER=
# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE=ws://localhost:8000/ws/v1
